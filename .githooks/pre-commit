#!/bin/sh
# Refuse a commit whose staged changes contain a secret. Enable with `make hooks`.

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed; run 'brew install gitleaks' (see https://github.com/gitleaks/gitleaks#installing)." >&2
    exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose
status=$?
if [ "$status" -ne 0 ]; then
    echo "pre-commit: commit refused. Remove the secret, or if the finding is a false positive, allowlist it in .gitleaks.toml." >&2
fi
exit "$status"
